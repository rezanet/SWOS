{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swos.dev/schemas/prose-benchmark-fixture-v1.json",
  "title": "SWOS Prose benchmark fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_id", "category", "benchmark_group", "mode", "assurance", "source", "semantic_probe_candidate", "semantic_relation", "diagnostics_expectation", "stability_probe", "notes"],
  "properties": {
    "fixture_id": {"type": "string", "pattern": "^(?:prose|repair)-[0-9]{3}$"},
    "category": {"type": "string", "minLength": 1},
    "benchmark_group": {"type": "string", "minLength": 1},
    "mode": {"enum": ["polish", "naturalise", "clarify", "tighten"]},
    "preset": {"type": ["string", "null"], "enum": ["scholarly-natural", "precise-technical", "plain-intelligent", "elegant-essay", "executive", null]},
    "assurance": {"const": "strict"},
    "source": {"type": "string", "minLength": 1},
    "semantic_probe_candidate": {"type": "string", "minLength": 1},
    "semantic_relation": {"enum": ["equivalent", "material_change"]},
    "diagnostics_expectation": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "must_not_abstain"],
      "properties": {
        "outcome": {"enum": ["NO_CHANGE_RECOMMENDED", "PROCEED_TO_REWRITE"]},
        "must_not_abstain": {"type": "boolean"},
        "expected_signal": {"type": "string", "minLength": 1}
      }
    },
    "stability_probe": {"type": "boolean"},
    "context_before": {"type": ["string", "null"]},
    "context_after": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  }
}

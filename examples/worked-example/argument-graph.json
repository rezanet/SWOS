      ]
    },
    {
      "node_id": "arg-00000002-0000-4000-8000-000000000000",
      "node_type": "grounds",
      "statement": "The primary study used a cross-sectional observational design.",
      "evidence_claim_ids": [
        "clm-00000003-0000-4000-8000-000000000000"
      ],
      "strength": "high",
      "status": "accepted"
    },
    {
      "node_id": "arg-00000003-0000-4000-8000-000000000000",
      "node_type": "grounds",
      "statement": "A pre-registered replication in a rural cohort did not reproduce the association.",
      "evidence_claim_ids": [
        "clm-00000003-0000-4000-8000-000000000000"
      ],
      "strength": "high",
      "status": "accepted"
    },
    {
      "node_id": "arg-00000004-0000-4000-8000-000000000000",
      "node_type": "warrant",
      "statement": "A cross-sectional observational design cannot distinguish causation from association, so it cannot discharge a causal claim.",
      "strength": "high",
      "hidden_premise": false,
      "status": "accepted"
    },
    {
      "node_id": "arg-00000005-0000-4000-8000-000000000000",
      "node_type": "backing",
      "statement": "This is the standard design-licensing principle in the psychology discipline pack's proof standard.",
      "strength": "high",
      "status": "accepted"
    },
    {
      "node_id": "arg-00000006-0000-4000-8000-000000000000",
      "node_type": "qualifier",
      "statement": "This concerns causal licensing only. The bounded association in the 65-74 urban cohort is well supported and is not disputed.",
      "strength": "high",
      "status": "accepted"
    },
    {
      "node_id": "arg-00000007-0000-4000-8000-000000000000",
      "node_type": "objection",
      "statement": "The replication failure could reflect population differences rather than absence of effect, in which case the effect may be real but bounded.",
      "strength": "medium",
      "status": "conceded"
    },
    {
      "node_id": "arg-00000008-0000-4000-8000-000000000000",
      "node_type": "rebuttal",
      "statement": "Conceded. This does not restore the causal licence: a bounded real effect and no effect are both consistent with the evidence, and neither is distinguishable without an experimental design.",
      "strength": "high",
      "status": "accepted"
    },
    {
      "node_id": "arg-00000009-0000-4000-8000-000000000000",
      "node_type": "rival_reading",
      "statement": "The effect is real but population-bounded to urban cohorts in that age band.",
      "strength": "medium",
      "status": "accepted"
    },
    {
      "node_id": "arg-0000000a-0000-4000-8000-000000000000",
      "node_type": "implication",
      "statement": "An experimental or quasi-experimental design in a broader population is required before a causal claim can be made.",
      "strength": "high",
      "status": "accepted"
    }

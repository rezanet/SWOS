  "thesis": {
    "node_id": "arg-00000001-0000-4000-8000-000000000000",
    "statement": "The current evidence base supports an association between intervention X and improved outcomes in a bounded population, but does not license a causal claim for older adults generally.",
    "contribution_type": "critique",
    "rival_theses_considered": [
      "Intervention X causes improved outcomes in older adults (rejected: no design licenses causation; replication failed).",
      "Intervention X has no effect (rejected: overstates the negative; the urban-cohort association is real and unexplained).",
      "The effect is real but population-bounded (retained as a rival reading; cannot be distinguished from the retained thesis on current evidence)."
    ]
  },
  "nodes": [
    {
      "node_id": "arg-00000001-0000-4000-8000-000000000000",
      "node_type": "claim",
      "statement": "Evidence does not license a causal claim for older adults generally.",
      "strength": "high",
      "status": "accepted",
      "evidence_claim_ids": [

# Optional live-evidence settings. Keep all real values outside the repository.
# Deterministic CI does not require an API key and never reads this file.
OPENAI_API_KEY=
SWOS_PROSE_RUN_LIVE_OPENAI=0
SWOS_PROSE_OPENAI_MODEL=gpt-5.6-luna
SWOS_PROSE_OPENAI_REWRITE_MODEL=gpt-5.6-luna
# Optional evidence telemetry; leave blank to report cost as unavailable.
SWOS_PROSE_INPUT_USD_PER_1K=
SWOS_PROSE_OUTPUT_USD_PER_1K=

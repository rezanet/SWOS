{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swos.example/schemas/document-manifest/document-manifest.schema.json",
  "title": "SWOS Documentation Authority Manifest",
  "description": "Machine-readable authority, lifecycle and supersession metadata for the SWOS documentation corpus.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "generated_at",
    "corpus",
    "source_inputs",
    "documents"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date"
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include_roots", "include_files", "exclude_prefixes"],
      "properties": {
        "include_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "include_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "exclude_prefixes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "source_inputs": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/sourceInput"}
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/document"}
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "title",
        "owner",
        "authority",
        "status",
        "version_scheme",
        "version",
        "canonical_for",
        "supersedes",
        "superseded_by"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "title": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "authority": {
          "type": "string",
          "enum": [
            "constitutional",
            "normative",
            "governance",
            "operational",
            "informative",
            "historical"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["draft", "active", "superseded", "deprecated", "historical"]
        },
        "version_scheme": {
          "type": "string",
          "enum": ["semver", "date", "living"]
        },
        "version": {
          "type": "string",
          "pattern": "^(?:[0-9]+\\.[0-9]+\\.[0-9]+|[0-9]{4}-[0-9]{2}-[0-9]{2}|current)$"
        },
        "canonical_for": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "supersedes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        },
        "superseded_by": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        }
      }
    },
    "sourceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sha256",
        "date",
        "role",
        "derived_canonical_documents"
      ],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "date": {"type": "string", "format": "date"},
        "role": {"type": "string", "enum": ["research_input"]},
        "derived_canonical_documents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        }
      }
    }
  }
}

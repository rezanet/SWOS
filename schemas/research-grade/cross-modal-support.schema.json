{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swos.dev/schemas/2.0.0/research-grade/cross-modal-support.schema.json",
  "title": "SWOS cross-modal support",
  "x-swos-version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["support_id", "claim_id", "observation_ids", "leg_status", "status", "weakest_leg"],
  "properties": {"support_id": {"type": "string"}, "claim_id": {"type": "string"}, "asset_id": {"type": ["string", "null"]}, "observation_ids": {"type": "array", "items": {"type": "string"}}, "leg_status": {"type": "object"}, "status": {"enum": ["supported", "limited", "blocked"]}, "weakest_leg": {"enum": ["supported", "limited", "blocked"]}, "limitations": {"type": "array", "items": {"type": "string"}}, "provenance": {"type": "object"}}
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swos.dev/schemas/2.0.0/research-grade/capability-promotion.schema.json",
  "title": "SWOS capability promotion decision",
  "x-swos-version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "enabled", "capability", "pack", "stage", "assessment_digest", "approval", "rollback_trigger"],
  "properties": {"status": {"enum": ["enabled", "disabled", "rolled_back"]}, "enabled": {"type": "boolean"}, "capability": {"type": "string"}, "pack": {"type": "string"}, "stage": {"type": "string"}, "assessment_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "approval": {"type": "object", "properties": {"approval_id": {"type": "string", "minLength": 1}, "approver_id": {"type": "string", "minLength": 1}, "approver_role": {"type": "string", "minLength": 1}, "approved_at": {"type": "string", "minLength": 1}, "disposition": {"const": "approved"}, "assessment_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "scope_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "operation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "epg_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "sdl_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true}, "rollback_trigger": {"type": "string"}, "effective_at": {"type": ["string", "null"]}, "expires_at": {"type": ["string", "null"]}},
  "allOf": [{"if": {"properties": {"status": {"const": "enabled"}}, "required": ["status"]}, "then": {"properties": {"approval": {"required": ["approval_id", "approver_id", "approver_role", "approved_at", "disposition", "assessment_digest", "candidate_digest", "scope_digest", "operation_digest", "epg_digest", "sdl_digest", "policy_digest"]}}}}]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swos.dev/schemas/2.0.0/research-grade/specialist-agent.schema.json",
  "title": "SWOS specialist agent contract",
  "x-swos-version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_id", "version", "discipline", "default_enabled", "enabled", "permissions", "fallback", "promotion"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "2.0.0"},
    "agent_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "display_name": {"type": "string"},
    "discipline": {"enum": ["art_history", "art_criticism"]},
    "pack_id": {"type": "string", "minLength": 1},
    "default_enabled": {"const": false},
    "enabled": {"const": false},
    "advertised": {"const": false},
    "route_stage": {"type": "string"},
    "role_separation": {"type": "object", "additionalProperties": true},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "tools": {"type": "array", "items": {"type": "object"}},
    "denied_permissions": {"type": "array", "items": {"type": "string"}},
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "operation", "preserves_observations"],
      "properties": {
        "mode": {"const": "pack_only"},
        "operation": {"type": "string"},
        "preserves_observations": {"const": true}
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "minimum_improvement", "lower_95_ci_above_zero", "default"],
      "properties": {
        "capability": {"const": "image_analysis"},
        "minimum_improvement": {"const": 0.08},
        "lower_95_ci_above_zero": {"const": true},
        "default": {"const": "disabled"}
      }
    }
  }
}

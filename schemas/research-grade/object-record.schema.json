  "properties": {"object_id": {"type": "string", "minLength": 1}, "object_type": {"type": "string"}, "label": {"type": "string"}, "creator": {"type": ["string", "null"]}, "date_or_period": {"type": ["string", "null"]}, "culture": {"type": ["string", "null"]}, "materials": {"type": "array", "items": {"type": "string"}}, "dimensions": {"type": "object"}, "collection": {"type": ["string", "null"]}, "current_location": {"type": ["string", "null"]}, "identifiers": {"type": "object"}, "identity_confidence": {"type": "string"}, "source_rights": {"type": "object"}, "provenance": {"type": "object"}, "competing_attributions": {"type": "array", "items": {"type": "string"}}}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swos.dev/schemas/2.0.0/research-grade/discipline-critique.schema.json",
  "title": "SWOS structured discipline critique",
  "x-swos-version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_id", "discipline", "pack_id", "pack_version", "ontology_version", "ontology_digest", "criteria", "findings", "mandatory_failures"],
  "properties": {
    "report_id": {"type": "string", "minLength": 1},
    "discipline": {"type": "string", "minLength": 1},
    "pack_id": {"type": "string", "minLength": 1},
    "pack_version": {"type": "string", "minLength": 1},
    "ontology_version": {"const": "2.0.0"},
    "ontology_digest": {"type": "string", "minLength": 1},
    "subject_digest": {"type": "string"},
    "evidence_digest": {"type": "string"},
    "criteria": {"type": "array", "items": {"$ref": "#/$defs/criterion"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "mandatory_failures": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "review_state": {"enum": ["machine_proposed", "human_confirmed", "human_revised"]},
    "blocking": {"type": "boolean"}
  },
  "$defs": {
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_iri", "label", "mandatory", "weight", "status", "finding_state"],
      "properties": {
        "criterion_iri": {"type": "string", "format": "uri"}, "label": {"type": "string"},
        "mandatory": {"type": "boolean"}, "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "status": {"enum": ["pass", "fail", "unknown"]},
        "finding_state": {"enum": ["machine_proposed", "blocking", "human_confirmed", "human_revised"]},
        "claim_refs": {"type": "array", "items": {"type": "string"}}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "finding_ids": {"type": "array", "items": {"type": "string"}}, "proof_standard_iris": {"type": "array", "items": {"type": "string", "format": "uri"}}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["finding_id", "discipline", "pack_id", "pack_version", "ontology_version", "ontology_digest", "criterion_iri", "failure_mode_iri", "finding_type", "severity", "review_state"],
      "properties": {
        "finding_id": {"type": "string"}, "discipline": {"type": "string"}, "pack_id": {"type": "string"}, "pack_version": {"type": "string"}, "ontology_version": {"const": "2.0.0"}, "ontology_digest": {"type": "string"}, "criterion_iri": {"type": "string", "format": "uri"}, "failure_mode_iri": {"type": "string"}, "finding_type": {"type": "string"}, "severity": {"enum": ["info", "warning", "major", "blocking"]}, "claim_refs": {"type": "array", "items": {"type": "string"}}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "observations": {"type": "array", "items": {"type": "string"}}, "reasoning": {"type": "string"}, "counter_position": {"type": "string"}, "limitation": {"type": "string"}, "remediation": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "review_state": {"enum": ["machine_proposed", "human_confirmed", "human_revised", "dismissed", "blocking"]}, "reviewer_refs": {"type": "array", "items": {"type": "string"}}, "epg_refs": {"type": "array", "items": {"type": "string"}}, "sdl_refs": {"type": "array", "items": {"type": "string"}}, "created_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}

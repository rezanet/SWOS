{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swos.dev/schemas/1.0.0/decision-ledger/sdl.schema.json",
  "title": "SWOS Scholarly Decision Ledger (SDL)",
  "description": "Append-only, tamper-evident record of scholarly JUDGEMENT. EPG explains where information came from; SDL explains why a judgement was made. The SDL must not duplicate Evidence Matrix rows - it references them. When evidence changes a decision is never overwritten; it is superseded, leaving the original rationale intact.",
  "type": "object",
  "required": [
    "schema_version",
    "work_id",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "work_id": {
      "$ref": "../common/common.schema.json#/$defs/id"
    },
    "append_only": {
      "const": true
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "decision_id",
        "decision_type",
        "question",
        "options_considered",
        "selected_option",
        "rationale",
        "review_status",
        "responsible_agent",
        "timestamp",
        "lifecycle_status",
        "reversibility"
      ],
      "properties": {
        "decision_id": {
          "$ref": "../common/common.schema.json#/$defs/id"
        },
        "decision_type": {
          "type": "string",
          "enum": [
            "scope",
            "source_inclusion",
            "source_exclusion",
            "claim_acceptance",
            "evidence_weighting",
            "contradiction_resolution",
            "thesis_selection",
            "warrant_selection",
            "interpretation",
            "method_judgement",
            "citation_support_judgement",
            "reviewer_outcome",
            "reviewer_override",
            "memory_write",
            "governance",
            "release",
            "retirement"
          ],
          "description": "A ledger entry is MANDATORY whenever SWOS accepts a claim, excludes a source, chooses one interpretation over another, resolves conflicting evidence, writes memory, passes a governance gate, or releases an output."
        },
        "question": {
          "type": "string",
          "description": "The decision actually being resolved, phrased as a question."
        },
        "options_considered": {
          "type": "array",
          "minItems": 2,
          "description": "Minimum two. A 'decision' with one option is not a decision; it is a default and must be recorded as such.",
          "items": {
            "type": "object",
            "required": [
              "option"
            ],
            "properties": {
              "option": {
                "type": "string"
              },
              "why_rejected": {
                "type": "string"
              },
              "supporting_evidence_refs": {
                "type": "array",
                "items": {
                  "$ref": "../common/common.schema.json#/$defs/id"
                }
              }
            }
          }
        },
        "selected_option": {
          "type": "string"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "criteria_applied": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The standard used, e.g. 'primary source preferred over commentary', 'systematic review outranks single study'."
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "../common/common.schema.json#/$defs/id"
          },
          "description": "Evidence Matrix claim_ids and EPG node ids. References, never copies."
        },
        "counter_evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "../common/common.schema.json#/$defs/id"
          }
        },
        "argument_refs": {
          "type": "array",
          "items": {
            "$ref": "../common/common.schema.json#/$defs/id"
          }
        },
        "confidence": {
          "$ref": "../common/common.schema.json#/$defs/confidence"
        },
        "uncertainty": {
          "type": "array",
          "items": {
            "$ref": "../common/common.schema.json#/$defs/uncertainty_type"
          }
        },
        "dissenting_view": {
          "type": "string",
          "description": "Recorded where a reviewer disagreed but was overruled. Suppressing dissent is a governance incident."
        },
        "review_status": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "rejected",
            "overridden",
            "escalated"
          ]
        },
        "responsible_agent": {
          "$ref": "../common/common.schema.json#/$defs/actor"
        },
        "human_approver": {
          "$ref": "../common/common.schema.json#/$defs/actor",
          "description": "Required when the approval matrix classifies this decision as high-risk."
        },
        "policy_basis": {
          "type": "string",
          "description": "The governance policy id that required or permitted this decision."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "review_date": {
          "type": "string",
          "format": "date",
          "description": "When this judgement must be revisited."
        },
        "lifecycle_status": {
          "type": "string",
          "enum": [
            "proposed",
            "evaluated",
            "approved",
            "challenged",
            "revised",
            "superseded",
            "retired"
          ]
        },
        "reversibility": {
          "type": "string",
          "enum": [
            "reversible",
            "superseded",
            "locked",
            "retired"
          ]
        },
        "supersedes_decision_id": {
          "$ref": "../common/common.schema.json#/$defs/id"
        },
        "epg_node_ids": {
          "type": "array",
          "items": {
            "$ref": "../common/common.schema.json#/$defs/id"
          }
        },
        "audit": {
          "$ref": "../common/common.schema.json#/$defs/audit_stamp"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "decision_type": {
                "enum": [
                  "release",
                  "memory_write",
                  "reviewer_override",
                  "retirement"
                ]
              }
            }
          },
          "then": {
            "required": [
              "human_approver",
              "policy_basis"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "lifecycle_status": {
                "const": "superseded"
              }
            }
          },
          "then": {
            "required": [
              "supersedes_decision_id"
            ]
          }
        }
      ]
    }
  }
}
